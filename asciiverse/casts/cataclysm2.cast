[0.000, "o", "\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m\"\u001b[33m\u001b[40m.\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m   \u001b[2;4H"]
