[0.000, "o", ".\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[20;3H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[20;23H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\r\u001b[21d\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\r\u001b[22d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\r\u001b[23d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\r\u001b[24d\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[32m\u001b[40m....\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\r\u001b[25d.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[30m\u001b[