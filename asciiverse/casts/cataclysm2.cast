[0.000, "o", "\u001b[36m\u001b[40m~~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m      \u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\r\u001b[28d~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[6b\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~~~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[29;3H"]
