[0.000, "o", "\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m###\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[37m\u001b[40m###\u001b[33m\u001b[40m++\u001b[37m\u001b[40m###\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[6b\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\r\u001b[10d\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[22b\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\r\u001b[11d\u001b[37m\u001b[40m{\u001b[11;24H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\r\u001b[12d\u001b[37m\u001b[40m{\u001b[10b\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[32m\u001b[40m&\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b[10b\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\r\u001b[13d\u001b[37m\u001b[40m.\u001b[24b\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[14;16H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&\u001b[14;25H\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b[33m\u001b[40m...\u001b[15;15H\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[15;25H.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[16;17H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&\u001b[25G\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[17;16H\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[17;25H.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[18;25H\u001b[37m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\r\u001b[19d\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[13b\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\r\u001b[20d\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[10G\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[20;25H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\r\u001b[21d\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~\u001b[12G\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[22;5H\u001b[37m\u001b[40m%\u001b[22;16H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[7b\u001b(B\u001b[0m\u001b[37m\u001b[40m%#\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\r\u001b[23d\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b[12G\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[24;4H"]
