[0.000, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b[3;5H"]
[0.000, "o", "\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.....\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[4;4H"]
[0.000, "o", "...\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m\"\u001b[33m\u001b[40m.\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[5;2H"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6;2H\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[32m\u001b[40m\"\"\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\r\u001b[7d"]
[0.000, "o", ".\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[37m\u001b[40m%\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[8;2H"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[9;4H"]
