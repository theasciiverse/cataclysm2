[0.000, "o", "\u001b[37m\u001b[40m.\u001b[14;25H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[15;15H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&\u001b[15;25H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b[33m\u001b[40m...\u001b[16;17H\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[25G\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[17;16H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&\u001b[17;25H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[18;25H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m.\r\u001b[19d\u001b[37m\u001b[40m.\u001b[23b\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\r\u001b[20d\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[10G%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[20;25H\u001b(B\u001b[0m\u001b[32m\u001b[40m....\r\u001b[21d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b[33m\u001b[40m...\u001b[12G\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[13b\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[22;5H.\u001b[22;16H\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\r\u001b[23d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[12G\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[10b\u001b(B\u001b[0m\u001b[37m\u001b[40m%#\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[24;4H.\u001b[11G\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\r\u001b[25d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m.\u001b[12G\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[26;2H\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[26;21H\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[27;4H.\u001b[8b\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[9b\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \r\u001b[28d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[28;11H\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[29;6H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[14G.\u001b[29;27H\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \r\u001b[30d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[12G\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[7b\u001b[27G\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\b\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
