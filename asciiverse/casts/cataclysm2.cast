[0.000, "o", "\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[32m\u001b[40m\"\"\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[30m\u001b[40m   \u001b[32m\u001b[40m..\u001b[4;4H"]
[0.000, "o", "\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[37m\u001b[40m%\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[30m\u001b[40m   \u001b[37m\u001b[40m{{{\u001b[5;4H"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[6;2H"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[32m\u001b[40m...\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[7;2H"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[8;4H"]
[0.000, "o", "#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[9;5H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[12b\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[10;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[21G\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[11;5H%\u001b[11;15H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[12;6H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[12;19H#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[28G\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\r\u001b[13d\u001b[30m\u001b[40m    \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[9b\u001b(B\u001b[0m\u001b[37m\u001b[40m%%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[28G{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[14;4H\u001b[30m\u001b[40m     \u001b[15G\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b[28G\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[15;6H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m##\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[15;28H{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\r\u001b[16d\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[11b\u001b[19G.\u001b[16;28H\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[17;10H#\u001b[17;19H#%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[18;4H\u001b[30m\u001b[40m   \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[18;20H\u001b(B\u001b[0m\u001b[30m\u001b[40m   \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\r\u001b[19d\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[19;21H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m    \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m{\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[20;4H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[20;22H..\u001b(B\u001b[0m\u001b[30m\u001b[40m     \u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[21;4H\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[21;24H%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[40m     \r\u001b[22d\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6b\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[22;25H...\u001b(B\u001b[0m\u001b[30m\u001b[40m   \r\u001b[23d\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[23;27H.\u001b(B\u001b[0m\u001b[37m\u001b[40m..\u001b[24;3H\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m...\r\u001b[25d"]
[0.000, "o", "\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[37m\u001b[40m...\r\u001b[26d\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[37m\u001b[40m%%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[27;2H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~~\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b(B\u001b[0m\u001b[37m\u001b[40m%#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~\u001b(B\u001b[0m\u001b[37m\u001b[40m.\r\u001b[28d\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b[37m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40mZ\r\u001b[29d\u001b(B\u001b[0m\u001b[36m\u001b[40m~~~~\u001b[30m\u001b[40m   \u001b[36m\u001b[40m~~~~~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~\u001b[11b\u001b[30m\u001b[40m \u001b[36m\u001b[40m~\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b[30;4H\u001b[30m\u001b[40m   \u001b[36m\u001b[40m~~~~~~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~~~~~~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~~~\u001b[30m\u001b[40m \u001b[36m\u001b[40m~~\u001b[30m\u001b[40m \u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~"]
