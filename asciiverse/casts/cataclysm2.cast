[0.000, "o", "pick them up with \u001b(B\u001b[0;1m\u001b[33m\u001b[40m,\u001b(B\u001b[0m\u001b[37m\u001b[40m.\u001b[30m\u001b[40m\u001b[23X\u001b[25;39H\u001b[37m\u001b[40mYour radio survived the storm: \u001b(B\u001b[0;1m\u001b[33m\u001b[40ma\u001b(B\u001b[0m\u001b[37m\u001b[40mpply it and\u001b[26;39Hlisten.  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m$\u001b(B\u001b[0m\u001b[37m\u001b[40m sleeps, \u001b(B\u001b[0;1m\u001b[33m\u001b[40m?\u001b(B\u001b[0m\u001b[37m\u001b[40m is help, \u001b(B\u001b[0;1m\u001b[33m\u001b[40mS\u001b(B\u001b[0m\u001b[37m\u001b[40m saves.\u001b[30m\u001b[40m     \u001b[27;39H\u001b[37m\u001b[40mYou wield the hatchet.\u001b[30m\u001b[40m\u001b[16X\u001b[28;39H"]
[0.001, "o", "\u001b(B\u001b[0;1m\u001b[32m\u001b[40mExamine where? (Press direction key)\u001b[29;39H\u001b(B\u001b[0m\u001b[37m\u001b[40mYou see here a MRE (meat).\u001b[30m\u001b[40m \u001b[9b\u001b[17;52H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
