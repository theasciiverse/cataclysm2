[0.001, "o", "\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[8b\r\u001b[9d.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m....\u001b[10;3H.\u001b[10;13H...\u001b[36m\u001b[40m~\r\u001b[11d\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[12G.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\r\u001b[12d\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[16G...\r\u001b[13d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~~~~~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\r\u001b[14d\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~~~~~~\u001b[33m\u001b[40m...\r\u001b[15d.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[16;3H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[37m\u001b[40m@\u001b[36m\u001b[40m~\r\u001b[17d\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m...\r\u001b[18d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\r\u001b[19d.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[12G\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[20;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\r\u001b[21d..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[21;28H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\r\u001b[22d\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[22;27H.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\r\u001b[23d.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m..\r\u001b[24d.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[25;27H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~\u001b[26;2H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[26;24H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\u001b[27;26H\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b[28;23H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[29d\b\b.\u001b[36m\u001b[40m~~~~\u001b[30;22H~~~~\u001b(B\u001b[0m\u001b[36m\u001b[40m~~~~\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
