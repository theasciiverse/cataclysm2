[0.000, "o", "\u001b[H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[1;23H\u001b[36m\u001b[40m~\r\u001b[2d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[2;24H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[36m\u001b[40m~\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~\r\u001b[3d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[3;26H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~~\r\u001b[4d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[4;26H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\r\u001b[5d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[5;26H\u001b[36m\u001b[40m~\u001b[6;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6;27H..\r\u001b[7d.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[7;29H\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\r\u001b[8d\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[8;30H.\r\u001b[9d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\r\u001b[10d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[12b\u001b[36m\u001b[40m~\r\u001b[11d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[11;12H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\r\u001b[12d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[12;11H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m~~~~\u001b[33m\u001b[40m.\u001b[13;2H.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~~~~~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\r\u001b[14d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~~~~~~\u001b[33m\u001b[40m....\u001b[15;2H....\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\r\u001b[16d\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[33m\u001b[40m....\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[37m\u001b[40m@\u001b[33m\u001b[40m..\r\u001b[17d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b[36m\u001b[40m~~~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m....\r\u001b[18d.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m...\u001b[36m\u001b[40m~\u001b[19;2H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[6b\u001b[36m\u001b[40m~\u001b[33m\u001b[40m..\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\u001b[36m\u001b[40m~\u001b[33m\u001b[40m.\r\u001b[20d\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[12G......\r\u001b[22d\u001b(B\u001b[0m\u001b[33m\u001b[40m..