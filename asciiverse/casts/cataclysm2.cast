[0.000, "o", "\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[36m\u001b[40m(\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[31m\u001b[40m$\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\r\u001b[18d\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[31m\u001b[40m/\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[31m\u001b[40m/\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[34m\u001b[40m;\u001b(B\u001b[0m\u001b[33m\u001b[40m.\r\u001b[19d\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[30m\u001b[40m;\u001b[33m\u001b[40m.....\u001b[34m\u001b[40m;\u001b[33m\u001b[40m.\u001b[31m\u001b[40m/\r\u001b[20d\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[7b\u001b[36m\u001b[40m(\u001b[21;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[31m\u001b[40m/*\r\u001b[22d\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b[22;17H"]
